---
const {
  title,
  description,
  date,
  tags = []
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const formattedDate = date
  ? new Intl.DateTimeFormat('es-ES', { month: 'long', day: 'numeric', year: 'numeric' }).format(date)
  : '';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <title>{title} | ANGARLO Notas</title>
  <meta property="og:type" content="article">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://sali.angarlo.com/assets/images/sali-share.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@angarlo">
  <meta name="twitter:creator" content="@angarlo">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://sali.angarlo.com/assets/images/sali-share.png">
  <link rel="alternate" hreflang="es" href={canonicalUrl}>
  <link rel="alternate" hreflang="en" href="https://sali.angarlo.com/notes">
  <link rel="alternate" hreflang="x-default" href="https://sali.angarlo.com/notes">
  <link rel="alternate" type="application/rss+xml" title="SALI Notas" href="https://sali.angarlo.com/rss.xml">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "url": canonicalUrl.toString(),
    "inLanguage": "es",
    ...(date ? { "datePublished": date.toISOString() } : {}),
    "author": {
      "@type": "Person",
      "name": "Angarlo",
      "url": "https://sali.angarlo.com/",
      "sameAs": ["https://twitter.com/angarlo"]
    },
    "publisher": {
      "@type": "Person",
      "name": "Angarlo",
      "url": "https://sali.angarlo.com/"
    }
  })}></script>
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/styles.css?v=20">
  <style>
    .note-shell {
      max-width: 760px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
    }
    .note-kicker,
    .note-date,
    .note-tags {
      font-family: var(--font-mono);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .note-kicker {
      font-size: 0.75rem;
      margin-bottom: 1rem;
    }
    .note-title {
      color: var(--color-text);
      font-size: clamp(2.4rem, 7vw, 4.25rem);
      line-height: 1.05;
      margin-bottom: 1rem;
      letter-spacing: 0;
    }
    .note-description {
      font-size: 1.2rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
      margin-bottom: 1.25rem;
    }
    .note-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 3rem;
      font-size: 0.75rem;
    }
    .note-content {
      font-size: 1.08rem;
      line-height: 1.8;
      color: var(--color-text-secondary);
    }
    .note-content :global(h2),
    .note-content :global(h3) {
      color: var(--color-text);
      margin-top: 2.5rem;
      letter-spacing: 0;
    }
    .note-content :global(p),
    .note-content :global(ul),
    .note-content :global(ol),
    .note-content :global(blockquote) {
      margin-bottom: 1.25rem;
    }
    .note-content :global(a) {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .note-footer {
      border-top: 1px solid var(--color-border);
      margin-top: 4rem;
      padding-top: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <script is:inline>try{var t=localStorage.getItem('sali.angarlo.theme')||localStorage.getItem('saliTheme');if(t==='dark')document.body.classList.add('dark');}catch(e){}</script>
  <nav class="nav">
    <div class="container nav__inner">
      <a href="/es/" class="nav__logo">ANGARLO</a>
      <ul class="nav__links">
        <li><a href="/es/" class="nav__link">Inicio</a></li>
        <li><a href="/es/methodology.html" class="nav__link">Metodología</a></li>
        <li><a href="/es/examples.html" class="nav__link">Ejemplos</a></li>
        <li><a href="/es/notas" class="nav__link nav__link--active">Notas</a></li>
        <li><a href="/es/dice-seed.html" class="nav__link">Semilla con Dados</a></li>
        <li><a href="/es/podcast.html" class="nav__link">Podcast</a></li>
        <li><a href="/es/contact.html" class="nav__link">Contacto</a></li>
      </ul>
      <button id="themeToggle" class="theme-toggle" aria-label="Cambiar modo oscuro">🌙</button>
    </div>
  </nav>

  <main class="note-shell">
    <div class="note-kicker">ANGARLO Notas</div>
    <h1 class="note-title">{title}</h1>
    <p class="note-description">{description}</p>
    <div class="note-meta">
      {formattedDate && <span class="note-date">{formattedDate}</span>}
      {tags.length > 0 && <span class="note-tags">{tags.join(' / ')}</span>}
    </div>
    <article class="note-content">
      <slot />
    </article>
    <div class="note-footer">
      <a href="/es/notas">Todas las notas</a>
      <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl.toString())}`} target="_blank" rel="noopener noreferrer">Compartir en X</a>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer__content">
      <p class="footer__disclaimer">
        SALI es solo para fines informativos y no constituye asesoramiento financiero.
      </p>
      <p class="footer__support">
        Apoya el mantenimiento continuo: <a href="lightning:angarlo@strike.me">⚡ angarlo@strike.me</a> · <a href="/es/contact.html#support">QR y más &rarr;</a>
      </p>
      <p class="footer__privacy">
        Análisis de privacidad amigable por Cloudflare Web Analytics. Sin cookies, sin rastreo publicitario. El sitio carga precios de BTC en vivo desde Coinbase, tasas de cambio del Banco Central Europeo (via Frankfurter), Chart.js desde jsDelivr, y el video del podcast desde youtube-nocookie.com. · <a href="/es/privacy.html">Política de Privacidad</a>
      </p>
      <p class="footer__sibling">
        Proyecto hermano: <a href="https://wcs.angarlo.com">The Whole Coin Standard</a>, una especificación para financiar un bitcoin entero (en inglés).
      </p>
      <p class="footer__contact">
        Contacto: <a href="mailto:angarlotv@gmail.com">angarlotv@gmail.com</a>
      </p>
    </div>
  </footer>

  <script is:inline src="/assets/js/theme.js?v=5"></script>
  <!-- Cloudflare Web Analytics -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"50af8042fed14fbdb35bde67c57585bf"}'></script>
  <!-- End Cloudflare Web Analytics -->
</body>
</html>
