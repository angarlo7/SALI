---
import { getCollection } from 'astro:content';

const notas = (await getCollection('notas'))
  .filter((nota) => !nota.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Notas, ensayos, actualizaciones, y todo lo que ANGARLO quiera publicar.">
  <title>Notas | ANGARLO</title>
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://sali.angarlo.com/es/notas">
  <meta property="og:title" content="Notas | ANGARLO">
  <meta property="og:description" content="Notas, ensayos, actualizaciones, y todo lo que ANGARLO quiera publicar.">
  <meta property="og:image" content="https://sali.angarlo.com/assets/images/sali-share.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@angarlo">
  <meta name="twitter:creator" content="@angarlo">
  <meta name="twitter:title" content="Notas | ANGARLO">
  <meta name="twitter:description" content="Notas, ensayos, actualizaciones, y todo lo que ANGARLO quiera publicar.">
  <meta name="twitter:image" content="https://sali.angarlo.com/assets/images/sali-share.png">
  <link rel="canonical" href="https://sali.angarlo.com/es/notas">
  <link rel="alternate" hreflang="en" href="https://sali.angarlo.com/notes">
  <link rel="alternate" hreflang="es" href="https://sali.angarlo.com/es/notas">
  <link rel="alternate" hreflang="x-default" href="https://sali.angarlo.com/notes">
  <link rel="alternate" type="application/rss+xml" title="SALI Notas" href="https://sali.angarlo.com/rss.xml">
  <link rel="stylesheet" href="/assets/css/styles.css?v=12">
  <style>
    .notes-shell {
      max-width: 920px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
    }
    .notes-title {
      color: var(--color-text);
      font-size: clamp(2.5rem, 7vw, 4.75rem);
      line-height: 1.05;
      margin-bottom: 1rem;
      letter-spacing: 0;
    }
    .notes-subtitle {
      max-width: 620px;
      font-size: 1.12rem;
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: 3rem;
    }
    .notes-list {
      display: grid;
      gap: 1rem;
    }
    .note-card {
      display: block;
      padding: 1.4rem 0;
      border-top: 1px solid var(--color-border);
      color: var(--color-text);
      text-decoration: none;
    }
    .note-card:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .note-card:hover h2 {
      color: var(--color-accent);
    }
    .note-card__meta {
      font-family: var(--font-mono);
      color: var(--color-text-muted);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.45rem;
    }
    .note-card h2 {
      color: var(--color-text);
      margin: 0 0 0.45rem;
      font-size: 1.55rem;
      letter-spacing: 0;
    }
    .note-card p {
      margin: 0;
      max-width: 660px;
    }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="container nav__inner">
      <a href="/es/" class="nav__logo">ANGARLO</a>
      <ul class="nav__links">
        <li><a href="/es/" class="nav__link">Inicio</a></li>
        <li><a href="/es/methodology.html" class="nav__link">Metodología</a></li>
        <li><a href="/es/examples.html" class="nav__link">Ejemplos</a></li>
        <li><a href="/es/notas" class="nav__link nav__link--active">Notas</a></li>
        <li><a href="/es/podcast.html" class="nav__link">Podcast</a></li>
        <li><a href="/es/contact.html" class="nav__link">Contacto</a></li>
      </ul>
      <button class="nav__hamburger" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
      <a href="/notes" class="lang-toggle" aria-label="Ver en inglés">🇺🇸</a>
      <button id="themeToggle" class="theme-toggle" aria-label="Cambiar modo oscuro">🌙</button>
    </div>
  </nav>

  <main class="notes-shell">
    <h1 class="notes-title">Notas</h1>
    <p class="notes-subtitle">Pensamientos cortos, pensamientos largos, anuncios, experimentos, ensayos, reflexiones, borradores, y todo lo que necesite una URL.</p>
    <div class="notes-list">
      {notas.length === 0 ? (
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">Sin notas aún — vuelve pronto.</p>
      ) : notas.map((nota) => (
        <a class="note-card" href={`/es/notas/${nota.slug}`}>
          <div class="note-card__meta">
            {new Intl.DateTimeFormat('es-ES', { month: 'short', day: 'numeric', year: 'numeric' }).format(nota.data.date)}
            {nota.data.tags.length > 0 && ` / ${nota.data.tags.join(' / ')}`}
          </div>
          <h2>{nota.data.title}</h2>
          <p>{nota.data.description}</p>
        </a>
      ))}
    </div>
  </main>

  <script is:inline src="/assets/js/theme.js?v=4"></script>
  <!-- Cloudflare Web Analytics -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"50af8042fed14fbdb35bde67c57585bf"}'></script>
  <!-- End Cloudflare Web Analytics -->
</body>
</html>
